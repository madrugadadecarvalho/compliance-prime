# Base de dados PostgreSQL (ver docker-compose.yml)
DATABASE_URL=postgres://compliance:compliance@localhost:5432/compliance_prime
DATABASE_SSL=false

# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=substitua-por-um-segredo-aleatorio-com-32-caracteres
BETTER_AUTH_URL=http://localhost:3000

# Permitir auto-registo (novos utilizadores entram como ANALISTA)
ALLOW_SIGNUP=true
